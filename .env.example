PORT=4318
HOST=127.0.0.1
HEADLESS=true
BROWSER_CHANNEL=chrome
BROWSER_PROFILE_DIR=.browser-profile
SEARCH_TIMEOUT_MS=45000
MAX_RESULTS=24

# Необязательно. Без AI сервис использует встроенный разбор запроса.
# Подходит OpenAI-совместимый API, включая Ollama: http://localhost:11434/v1
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen2.5:7b
